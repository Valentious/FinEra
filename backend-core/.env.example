# FinEra Backend - Environment Configuration
# Copy to .env and fill in values
# For secure setup: .\scripts\secure-env-setup.ps1

NODE_ENV=development
PORT=4000

# Database - STANDARDIZED: finera:finera_secure
# Local: postgres host. Docker: use host "postgres"
DATABASE_URL="postgresql://finera:finera_secure@localhost:5432/finera_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Security
BCRYPT_SALT_ROUNDS=12

# CORS
FRONTEND_URL=http://localhost:5175

# Rate Limits (fintech: stricter for auth)
RATE_LIMIT_AUTH=5
RATE_LIMIT_GENERAL=100

# OTP / transactional email (use ONE provider)
# See docs/EMAIL_DELIVERY.md for SPF/DKIM/DMARC and production checklist.
EMAIL_PROVIDER=
# Sender - must match a verified domain/sender in your provider (not a personal @gmail.com for prod)
EMAIL_FROM="FinEra <noreply@yourdomain.com>"

# Resend - https://resend.com
RESEND_API_KEY=

# SendGrid - https://sendgrid.com (must set SENDGRID_SANDBOX_MODE=false for real delivery)
SENDGRID_API_KEY=
SENDGRID_SANDBOX_MODE=false

# Amazon SES (optional)
AWS_SES_REGION=
# Uses same keys as S3 if set, or set explicitly for SES-only IAM user
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Dev: log OTP to server logs when email is not configured or send fails (never use in production)
EMAIL_DEV_FALLBACK_LOG=true
EMAIL_DEV_LOG_OTP=true

# OTP: in development, any 6-digit code is accepted (set to false to enforce real OTP). In production, only honored if EMAIL_OTP_ACCEPT_ANY=true (not recommended).
EMAIL_OTP_ACCEPT_ANY=true

# Optional: SMTP (legacy - not used by OTP pipeline; OTP uses Resend/SendGrid/SES above)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: S3 for document storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
