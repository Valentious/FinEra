// FinEra Inclusive Credit - Production Database Schema (Genius Mode)
// PostgreSQL 15+ with Prisma ORM 5+
// ACID-compliant, 8 decimal precision for financial data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum AccountType {
  STUDENT
  STAFF
  ALUMNI
}

enum AccountTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CurrencyCode {
  USD
  ZIG
  ZAR
  EUR
  GBP
}

// Dynamic dashboard config - each currency is an independent dashboard system
model CurrencyRegistry {
  id             String   @id @default(uuid())
  currencyCode   CurrencyCode @unique
  displayName    String
  symbol         String   // e.g. $, Z$, R, €, £
  status         String   @default("active")  // active | inactive
  custodyType    String   // bank | momo | blockchain
  dashboardConfig Json    @default("{}")  // UI rules: minAmount, maxAmount, feePercent, dailyLimit, features[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  FEE
  INTEREST
  TRANSFER
  FX_CONVERSION
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum LoanStatus {
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  DEFAULTED
  WRITTEN_OFF
  RESTRUCTURED
}

enum InterestType {
  FIXED
  VARIABLE
  TIERED
}

enum InterestCalculationMethod {
  SIMPLE
  COMPOUND
  REDUCING_BALANCE
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum RepaymentStatus {
  PENDING
  PARTIAL
  PAID
  SKIPPED
  DEFAULTED
}

enum KycDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  PROOF_OF_ADDRESS
  SELFIE
  UTILITY_BILL
}

enum KycDocumentSide {
  FRONT
  BACK
  SINGLE
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum NotificationType {
  TRANSACTION
  LOAN_REMINDER
  KYC_UPDATE
  SYSTEM_ALERT
  PROMOTIONAL
  SECURITY_ALERT
  LEARNING_NUDGE
  LEARNING_RECOMMENDATION
  DEFAULT_WARNING
}

enum LearningModuleTier {
  FREE
  PREMIUM
}

enum LearningModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum RecommendationType {
  LESSON
  MICRO_COURSE
  WARNING
  NUDGE
}

enum LearningProfileRiskLevel {
  low
  medium
  high
  critical
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum FraudRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAction {
  ALLOW
  FLAG
  REQUIRE_2FA
  BLOCK
}

/// Staff roles for admin dashboard (RBAC)
enum AdminRole {
  ADMIN
  RISK_OFFICER
  AUDITOR
}

// ==================== MODELS ====================
//
// NORMALIZATION: Identity vs Credentials
// - User: identity only (user_id, email, profile). Single responsibility.
// - UserAuth: credentials (password_hash, lockout, sessions). Separated for 3NF.
// - email = UNIQUE secondary key (lookup); password_hash depends on user_id via UserAuth
// - Login: 1) find User by email, 2) get UserAuth by user_id, 3) verify password

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  fullName                String
  /// Sensitive PII (KYC / GDPR). Stored as calendar date; use DB/app encryption at rest in production.
  dateOfBirth             DateTime? @db.Date
  /// When true, DOB cannot be changed via self-service (support/admin only).
  dateOfBirthLocked       Boolean   @default(false)
  accountType             AccountType
  accountTier             AccountTier @default(TIER_0)
  countryCode             String    // ISO 3166-1 alpha-2/3
  city                    String?
  institution             String?
  institutionId           String?
  phoneNumber             String?   @unique
  /// Salutation shown in profile (Mr, Mrs, Ms, Dr, ...)
  title                   String?
  /// UI locale: en, es, fr, pt, sw, sn, nd, af (ISO-style codes)
  preferredLanguage       String    @default("en")
  phoneVerified           Boolean   @default(false)
  emailVerified           Boolean   @default(false)
  /// Bcrypt hash of the current email OTP (never store plaintext).
  emailVerificationToken  String?
  emailVerificationExpiry DateTime?
  /// Last time a registration/resend OTP email was sent (cooldown + abuse limits).
  emailOtpLastSentAt      DateTime?
  deviceFingerprints      Json?     // Array of known device hashes
  status                  UserStatus @default(PENDING_VERIFICATION)
  statusReason            String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  metadata                Json?

  authCredentials        UserAuth?
  wallets                 Wallet[]
  transactions            Transaction[]
  creditProfile           CreditProfile?
  repayments              Repayment[]
  loans                   Loan[]
  kycDocuments            KycDocument[]
  notifications           Notification[]
  fraudLogs               FraudLog[]
  auditLogs                AuditLog[]
  learningProfile         UserLearningProfile?
  termInteractions        TermInteraction[]
  progressTracking        ProgressTracking[]
  recommendationsLog       RecommendationLog[]
  partnerProgram          PartnerProgram?
  portfolioSnapshots      PortfolioSnapshot[]

  @@index([email])
  @@index([countryCode, accountType])
  @@index([status, createdAt])
}

model UserAuth {
  id                   String    @id @default(uuid())
  userId               String    @unique
  passwordHash         String
  passwordLastChanged  DateTime  @default(now())
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIP          String?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  refreshToken         String?
  refreshTokenExpiry   DateTime?
  resetToken           String?
  resetTokenExpires    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Each user has MULTIPLE wallets. Each wallet = ONE currency ONLY.
// UNIQUE(user_id, currency_code) - one wallet per currency per user.
// Operations in one currency NEVER affect another.
model Wallet {
  id                    String      @id @default(uuid())
  userId                String
  currencyCode          CurrencyCode
  accountNumber         String      @unique // Structured ledger account (digits)
  /// Public 10-digit peer transfer ID (Binance-style), unique globally per wallet
  walletNumericId       String?     @unique @map("wallet_numeric_id")
  balance               Decimal     @default(0) @db.Decimal(18, 8)
  availableBalance      Decimal     @default(0) @db.Decimal(18, 8)
  holdBalance           Decimal     @default(0) @db.Decimal(18, 8)
  /// Legacy column name; kept in sync with `balance` for each currency wallet. API uses `balance` only.
  savingsBalance        Decimal     @default(0) @db.Decimal(18, 8)
  approvedCreditBalance  Decimal     @default(0) @db.Decimal(18, 8)
  savingsGoal           Decimal?    @db.Decimal(18, 8)
  activeLoanBalance     Decimal     @default(0) @db.Decimal(18, 8)
  totalLoanAmount       Decimal     @default(0) @db.Decimal(18, 8)
  totalRepaidAmount     Decimal     @default(0) @db.Decimal(18, 8)
  status                String      @default("active")  // active | suspended | closed
  isActive              Boolean     @default(true)
  lastTransactionAt     DateTime?
  dailyTransactionTotal  Decimal    @default(0) @db.Decimal(18, 8)
  dailyTransactionCount  Int        @default(0)
  monthlyTransactionTotal Decimal   @default(0) @db.Decimal(18, 8)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  loans        Loan[]

  @@unique([userId, currencyCode])
  @@index([userId, currencyCode])
  @@index([accountNumber])
  @@index([currencyCode])
}

// Each currency has its OWN ledger system. No cross-currency entries.
enum LedgerType {
  CUSTODY
  SETTLEMENT
  CLEARING
}

model Ledger {
  id           String     @id @default(uuid())
  currencyCode CurrencyCode @unique  // One ledger per currency
  ledgerName   String?    // e.g. "USD_MAIN_LEDGER" - human-readable per spec
  ledgerType   LedgerType @default(CUSTODY)
  systemBalance Decimal   @default(0) @db.Decimal(18, 8)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  entries     LedgerEntry[]
  transactions Transaction[]

  @@index([currencyCode])
}

// Double-entry ledger entries. Each currency queries ONLY its own entries.
model LedgerEntry {
  id            String   @id @default(uuid())
  ledgerId      String
  transactionId String
  currencyCode  CurrencyCode  // MUST match ledger.currencyCode
  entryType     String   // DEBIT | CREDIT
  /// Chart-of-accounts code, e.g. ASSET:CUSTODY:USD, LIABILITY:WALLET:{walletId}
  accountCode   String   @default("LEGACY:UNSPECIFIED")
  amount        Decimal  @db.Decimal(18, 8)
  balanceAfter  Decimal  @db.Decimal(18, 8)
  description   String?
  createdAt     DateTime @default(now())

  ledger Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId, createdAt(sort: Desc)])
  @@index([transactionId])
  @@index([currencyCode])
  @@index([accountCode])
}

// transaction.currency_code MUST match wallet.currency_code.
// Each tx affects ONLY one wallet + its corresponding ledger.
model Transaction {
  id               String            @id @default(uuid())
  reference        String            @unique // TXN-YYYYMMDD-8chars (idempotency key)
  userId           String
  walletId         String
  ledgerId         String?           // FK to ledger - which currency ledger this tx was posted to
  transactionType  TransactionType
  amount           Decimal           @db.Decimal(18, 8)
  fee              Decimal           @default(0) @db.Decimal(18, 8)
  netAmount        Decimal           @db.Decimal(18, 8)
  currency         CurrencyCode      // MUST match wallet.currencyCode
  exchangeRate     Decimal?          @db.Decimal(18, 8)
  originalCurrency CurrencyCode?
  originalAmount   Decimal?          @db.Decimal(18, 8)
  status           TransactionStatus @default(PENDING)
  failureReason    String?
  failureCode      String?
  metadata         Json?
  externalReference String?
  reversalReference String?
  reversalReason   String?
  approvedBy       String?
  approvalNote     String?
  /// Tamper-evident hash chain (per currency ledger). Previous journal hash or GENESIS.
  ledgerPreviousHash String?         @map("ledger_previous_hash")
  /// SHA-256 of canonical payload including previous hash (see hash-chain service).
  ledgerEntryHash    String?         @unique @map("ledger_entry_hash")
  /// Primary journal pair for reporting (double-entry legs use accountCode on LedgerEntry).
  ledgerDebitAccount  String?        @map("ledger_debit_account")
  ledgerCreditAccount String?        @map("ledger_credit_account")
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  ledger Ledger? @relation(fields: [ledgerId], references: [id])
  repayments Repayment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, currency])
  @@index([walletId, currency])
  @@index([reference])
  @@index([status, createdAt])
  @@index([walletId, transactionType])
  @@index([ledgerId, createdAt(sort: Desc)])
}

/// Staff users (separate from end-user `User`). JWT `kind: admin`.
model AdminUser {
  id             String    @id @default(uuid())
  email          String    @unique
  fullName       String
  passwordHash   String
  role           AdminRole @default(ADMIN)
  faceIdEnabled  Boolean   @default(false)
  phone          String?
  address        String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  auditLogs AdminAuditLog[]

  @@index([email])
  @@index([role, isActive])
}

/// Immutable admin action trail (court-grade; duplicates structured fields in AuditLog for admin scope).
model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  entityType  String
  entityId    String
  currency    CurrencyCode?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  timestamp   DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, timestamp(sort: Desc)])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model Loan {
  id                    String     @id @default(uuid())
  loanNumber            String     @unique // LN-YYYYMM-6random
  userId                String
  walletId              String
  principalAmount       Decimal    @db.Decimal(18, 8)
  interestRate          Decimal    @db.Decimal(5, 2)
  interestType          InterestType @default(FIXED)
  interestCalculationMethod InterestCalculationMethod @default(REDUCING_BALANCE)
  totalInterest         Decimal    @db.Decimal(18, 8)
  fees                  Decimal    @default(0) @db.Decimal(18, 8)
  totalRepayable       Decimal    @db.Decimal(18, 8)
  amountDisbursed      Decimal    @default(0) @db.Decimal(18, 8)
  remainingBalance     Decimal    @db.Decimal(18, 8)
  currency              CurrencyCode
  term                  Int
  termUnit              String     @default("MONTHS")
  paymentFrequency      PaymentFrequency @default(MONTHLY)
  installmentAmount     Decimal    @db.Decimal(18, 8)
  disbursementDate      DateTime?
  firstPaymentDate      DateTime?
  nextPaymentDate       DateTime?
  lastPaymentDate       DateTime?
  maturityDate          DateTime
  status                LoanStatus @default(PENDING)
  defaultDate           DateTime?
  delinquencyStage      Int        @default(0)
  collateral            Json?
  guarantor             Json?
  approvalDate          DateTime?
  approvedBy            String?
  approvalNotes         String?
  disbursedBy           String?
  disbursedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  repayments Repayment[]

  @@index([userId, status])
  @@index([status, nextPaymentDate])
  @@index([loanNumber])
}

model Repayment {
  id              String         @id @default(uuid())
  loanId          String
  userId          String
  transactionId   String?
  scheduledDate   DateTime
  expectedAmount  Decimal        @db.Decimal(18, 8)
  paidAmount      Decimal        @default(0) @db.Decimal(18, 8)
  principalPortion Decimal       @default(0) @db.Decimal(18, 8)
  interestPortion Decimal       @default(0) @db.Decimal(18, 8)
  feePortion      Decimal       @default(0) @db.Decimal(18, 8)
  paidDate        DateTime?
  daysLate        Int           @default(0)
  paidOnTime      Boolean?
  status          RepaymentStatus @default(PENDING)
  paymentMethod   String?
  receiptGenerated Boolean      @default(false)
  receiptUrl      String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([loanId, scheduledDate])
  @@index([userId, paidDate])
}

model CreditProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  financialDisciplineScore Int
  previousScore           Int?
  scoreFactors            Json?
  scoreHistory            Json?
  creditLimit             Decimal @db.Decimal(18, 8)
  availableCredit         Decimal @db.Decimal(18, 8)
  totalCreditUtilized     Decimal @default(0) @db.Decimal(18, 8)
  creditUtilizationRatio  Decimal @default(0) @db.Decimal(5, 2)
  repaymentReliability    Decimal @db.Decimal(5, 2)
  savingsConsistency      Decimal @db.Decimal(5, 2)
  transactionHealth       Decimal @db.Decimal(5, 2)
  accountLongevity        Int
  kycLevelBonus           Int
  lastScoreUpdate         DateTime?
  nextScoreUpdate         DateTime?
  scoreVersion            String?
  riskLevel               RiskLevel
  riskNotes               String?
  manualOverrideLimit     Decimal? @db.Decimal(18, 8)
  manualOverrideReason    String?
  manualOverrideExpiry    DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([riskLevel, lastScoreUpdate])
}

model KycDocument {
  id               String           @id @default(uuid())
  userId           String
  documentType     KycDocumentType
  documentSide     KycDocumentSide? @default(SINGLE)
  status           KycDocumentStatus @default(PENDING)
  filePath         String
  fileHash         String?
  fileName         String?
  fileSize         Int?
  mimeType         String?
  extractedData    Json?
  verificationMethod String?
  verifiedBy       String?
  verifiedAt       DateTime?
  rejectionReason  String?
  rejectionDetails Json?
  expiryDate       DateTime?
  uploadedAt       DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType, status])
}

model FraudLog {
  id            String         @id @default(uuid())
  userId        String?
  sessionId     String?
  ruleTriggered String
  riskScore     Int
  riskLevel     FraudRiskLevel
  action        String
  actionTaken   String
  details       Json?
  metadata      Json?
  resolved      Boolean        @default(false)
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([riskLevel, resolved])
  @@index([createdAt])
}

model Notification {
  id           String             @id @default(uuid())
  userId       String
  type         NotificationType
  priority     NotificationPriority @default(MEDIUM)
  title        String
  message      String
  data         Json?
  isRead       Boolean            @default(false)
  readAt       DateTime?
  isDelivered  Boolean            @default(false)
  deliveredAt  DateTime?
  actionTaken  Boolean            @default(false)
  actionUrl    String?
  expiresAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([type, priority])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  adminId    String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  requestId  String?
  timestamp  DateTime @default(now())
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp(sort: Desc)])
  @@index([entityType, entityId])
  @@index([timestamp])
}

/// Persisted domain events (outbox / audit feed; RabbitMQ carries async delivery).
model DomainEvent {
  id        String   @id @default(uuid())
  name      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([name, createdAt(sort: Desc)])
  @@map("domain_events")
}

// ==================== LEARNING HUB MODELS ====================

model FinancialTerm {
  id               String   @id @default(uuid())
  term             String   @unique
  slug             String   @unique
  simpleDefinition String
  advancedDefinition String?
  example          String?
  relatedTerms     String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([term])
  @@index([slug])
}

model LearningModule {
  id                  String              @id @default(uuid())
  moduleCode          String              @unique
  title               String
  slug                String              @unique
  description         String?
  difficultyLevel     Int?                // 1-5
  category            String?
  estimatedDurationMinutes Int?
  durationMinutes     Int?
  prerequisites       Json?               @default("[]")
  content             Json?               // { sections: [{ title, text, quiz? }] }
  tier                LearningModuleTier  @default(FREE)
  status              LearningModuleStatus @default(PUBLISHED)
  orderIndex          Int                 @default(0)
  icon                String?
  color               String?
  termsIncluded       String[]            @default([])
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  progress         ProgressTracking[]
  termInteractions TermInteraction[]

  @@index([tier, status])
  @@index([slug])
  @@index([moduleCode])
}

model UserLearningProfile {
  id                      String                 @id @default(uuid())
  userId                  String                 @unique
  userType                String                 @default("student") // student, staff, alumni
  disciplineScoreBonus    Int                    @default(0)
  financialDisciplineScore Decimal                @default(0) @db.Decimal(5, 2)
  riskLevel               LearningProfileRiskLevel @default(low)
  learningStreakDays      Int                    @default(0)
  weakKnowledgeAreas      String[]               @default([])
  strongKnowledgeAreas    String[]               @default([])
  lastActiveAt            DateTime?
  lastActivityAt          DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TermInteraction {
  id              String   @id @default(uuid())
  userId          String
  term            String   // term string (e.g. "credit_score")
  termId          String?  // optional FK to FinancialTerm
  interactionType String   // "hover", "click", "ask_ai"
  contextModuleId String?
  context         String?
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module LearningModule? @relation(fields: [contextModuleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([term])
  @@index([createdAt])
}

model ProgressTracking {
  id               String        @id @default(uuid())
  userId           String
  moduleId        String
  status          ProgressStatus @default(NOT_STARTED)
  progressPercent Int           @default(0)
  timeSpentSeconds Int          @default(0)
  quizScores      Json?         @default("[]")
  lastAccessedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@index([userId, status])
}

model RecommendationLog {
  id            String            @id @default(uuid())
  userId        String
  type          RecommendationType
  moduleId      String?
  contentId     String?
  termId        String?
  context       String?
  reason        String?
  priority      Int               @default(1)
  shownAt       DateTime          @default(now())
  isActioned    Boolean           @default(false)
  actionedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, shownAt(sort: Desc)])
  @@index([type])
  @@index([userId, isActioned])
}

model PartnerProgram {
  id              String   @id @default(uuid())
  userId          String   @unique
  status          String   @default("NOT_APPLIED") // NOT_APPLIED | PENDING | APPROVED | REJECTED
  applicationData Json?    @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model RefreshTokenBlacklist {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([expiresAt])
}

model PortfolioSnapshot {
  id               String   @id @default(uuid())
  userId           String
  snapshotDate     DateTime @db.Date
  totalSavings     Decimal  @db.Decimal(18, 8)
  activeCredit     Decimal  @db.Decimal(18, 8)
  approvedCredit   Decimal  @db.Decimal(18, 8)
  totalDeposited   Decimal  @default(0) @db.Decimal(18, 8)
  totalWithdrawn   Decimal  @default(0) @db.Decimal(18, 8)
  totalRepaid      Decimal  @default(0) @db.Decimal(18, 8)
  currencyCode     CurrencyCode
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate, currencyCode])
  @@index([userId])
  @@index([snapshotDate])
}
