{
  "name": "finera-backend-core",
  "version": "1.0.0",
  "description": "FinEra Inclusive Credit - Production Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:truncate": "npx tsx scripts/truncate-all-data.ts",
    "db:studio": "npx prisma studio",
    "setup:docker": "docker compose up -d",
    "setup:verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-stack.ps1",
    "test:db": "npx tsx src/test/verify-database.ts",
    "test:integration": "powershell -ExecutionPolicy Bypass -File ./scripts/test-full-stack.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "npm run test -- --run security",
    "test:load": "artillery quick --count 10 -n 20 http://localhost:4000/health"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1017.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "artillery": "^2.0.14",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
