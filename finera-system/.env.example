# FinEra - Root environment (copy to .env)
# Services inherit DATABASE_URL from here when run from finera-system root

DATABASE_URL="postgresql://finera:finera_secure@localhost:5432/finera_db?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Service URLs (for auth-service orchestration)
USER_SERVICE_URL="http://localhost:4002"
LEDGER_SERVICE_URL="http://localhost:4004"
CREDIT_ENGINE_URL="http://localhost:4003"
ADMIN_SERVICE_URL="http://localhost:4006"

# Event Bus (RabbitMQ) - optional, enables event-driven architecture
RABBITMQ_URL="amqp://finera:finera_secure@localhost:5672"
EVENT_BUS_ENABLED="true"
EVENT_CONSUMER_ENABLED="true"
