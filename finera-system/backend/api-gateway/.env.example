# FinEra API Gateway - RBAC Configuration (5000 to avoid conflict with backend-core)
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-rotate-regularly
JWT_EXPIRES_IN=24h

# Service URLs
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
CREDIT_ENGINE_URL=http://localhost:4003
LEDGER_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005
ADMIN_SERVICE_URL=http://localhost:4006

# Rate Limiting (requests per 15 min)
RATE_LIMIT_USER=100
RATE_LIMIT_ADMIN=500
RATE_LIMIT_SUPER_ADMIN=2000

# Security
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
