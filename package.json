{
  "name": "finera-inclusive-financial-ecosystem",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev-prelude.mjs && concurrently -n fe,be \"vite\" \"npm run dev:backend\"",
    "start:dev": "sh start-dev.sh",
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --prefix backend-core",
    "install:backend": "npm install --prefix backend-core --no-audit --no-fund",
    "db:generate": "npm run db:generate --prefix backend-core",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:reset": "sh scripts/docker-dev-reset.sh",
    "health": "node scripts/check-health.js"
  },
